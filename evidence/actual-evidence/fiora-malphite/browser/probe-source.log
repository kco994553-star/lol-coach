const fs=require('fs'),assert=require('assert/strict'),{chromium}=require('playwright');(async()=>{const browser=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--no-sandbox']}),page=await browser.newPage({viewport:{width:1440,height:1000},reducedMotion:'reduce'}),snapshots=[],errors=[];page.on('pageerror',e=>errors.push(e.stack));const ready=async url=>{await page.goto(url);await page.waitForSelector('#analyze:enabled');}; const coachFlow=async(label)=>{
  const base=process.env.LOADING_WEB+'/lol-coach/';await ready(base+'loading.html');
  await page.locator('#example-0').click();await page.locator('#analyze').click();await page.waitForSelector('#loading-coach .coach-matrix');
  const host=page.locator('#loading-coach'),view=host.locator('.loading-coach');
  const button=key=>host.locator('[data-coach-focus="'+key+'"]');
  const condition=async(key,value)=>{await host.locator('details[id$="-conditions"]').evaluate(e=>e.open=true);await button('condition-'+key).selectOption(value);await page.waitForFunction(()=>document.querySelector('#loading-coach').getAttribute('aria-busy')==='false');};
  await page.locator('#input-panel').evaluate(e=>e.open=true);await page.locator('#example-1').click();await page.locator('#analyze').click();assert.equal(await view.getAttribute('data-matchup'),'E');assert.match(await host.locator('.coach-board').innerText(),/말파이트.*마나|마나.*방어/s);assert(!/확보 전 처리/.test(await host.locator('.coach-evidence-kind').innerText()));assert.equal(await host.locator('.coach-phase-plans table').first().locator('tr').count(),7);assert.match(await host.locator('[data-counterplan=theirs]').innerText(),/말파이트의 지진의 파편\(Q\)/);assert(!/신비한 화살|비전 이동|카이사/.test(await host.locator('.coach-execution-steps').textContent()));assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));snapshots.push({kind:'fiora-default',device:label,board:await host.locator('.coach-board').innerText(),phases:await host.locator('.coach-phase-plans').innerText(),wave:await host.locator('.coach-wave-four').innerText(),ours:await host.locator('[data-counterplan=ours]').innerText(),theirs:await host.locator('[data-counterplan=theirs]').innerText()});await page.screenshot({path:process.env.LOADING_OUT+'/'+label+'-fiora-default.png'});await host.locator('.coach-phase-plans').evaluate(e=>e.scrollIntoView({block:'start',behavior:'instant'}));await page.evaluate(()=>new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r))));await page.screenshot({path:process.env.LOADING_OUT+'/'+label+'-fiora-phases.png'});
  await button('period-LEVEL3_5').click();assert.match(await host.locator('.coach-wave-four').innerText(),/応|응수|지면 강타/);const fmGrid=await host.locator('.coach-matrix').textContent();for(const risk of ['LOSS_LIMIT','OPPORTUNITY']){await button('risk-'+risk).click();assert.equal(await host.locator('.coach-matrix').textContent(),fmGrid);assert.match(await host.locator('.coach-comparison-reason').count()?await host.locator('.coach-comparison-reason').innerText():await host.locator('.coach-choice-comparison').innerText(),/같|수급|자원/);}
  await condition('enemy_key','SPENT');assert.match(await host.locator('.coach-wave-four').innerText(),/소모|추격/);await condition('enemy_key','UNKNOWN');assert.equal(await host.locator('.coach-matrix td[data-assessment=ALLY]').count(),0);await button('reset-scenario').click();await button('period-LEVEL6').click();await condition('resources','LOW');assert(!/대결투\(R\).*급소 접근/.test(await host.locator('.coach-trade-side').first().innerText()));await button('reset-scenario').click();await button('period-FIRST_PURCHASE').click();assert.match(await host.locator('.coach-stage').count()?await host.locator('.coach-stage').innerText():await host.locator('[role=tabpanel]').innerText(),/덤불|방어 구매/);await page.screenshot({path:process.env.LOADING_OUT+'/'+label+'-fiora-purchase.png'});const fmWhy=host.locator('details[id$="-knowledge-application"]');await fmWhy.evaluate(e=>e.open=true);const whyApp=fmWhy.locator('details').first();if(await whyApp.count())await whyApp.evaluate(e=>e.open=true);assert.match(await fmWhy.innerText(),/Anoying|Potent/);assert(await fmWhy.locator('blockquote').count()>0);await fmWhy.evaluate(e=>e.scrollIntoView({block:'start',behavior:'instant'}));await page.evaluate(()=>new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r))));await page.screenshot({path:process.env.LOADING_OUT+'/'+label+'-fiora-source.png'});await fmWhy.evaluate(e=>e.open=false);await button('period-LEVEL3_5').click();await button('line-step-2').click();assert.equal(await host.locator('.coach-line').first().getAttribute('data-step'),'2');assert.match(await host.locator('.coach-step-copy').first().innerText(),/말파이트|응수/);
  await page.locator('#input-panel').evaluate(e=>e.open=true);await page.locator('#pick-ENEMY-0').fill('Garen');await page.locator('#analyze').click();assert.equal(await view.getAttribute('data-matchup'),'UNSUPPORTED');assert.equal(await host.locator('.coach-line').count(),0);assert(!/신비한 화살|비전 이동/.test(await host.locator('.coach-execution-steps').textContent()));
 };
for(const [label,width,height]of[['desktop',1440,1000],['mobile',390,844]]){await page.setViewportSize({width,height});await coachFlow(label);}assert.equal(errors.length,0,errors.join('\n'));fs.writeFileSync(process.env.LOADING_OUT+'/result.json',JSON.stringify({passed:true,snapshots},null,2));await browser.close();})().catch(e=>{console.error(e);process.exit(1)});