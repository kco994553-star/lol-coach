const fs=require('fs'),assert=require('assert/strict'),{chromium}=require('playwright');(async()=>{const b=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--no-sandbox']}),p=await b.newPage({reducedMotion:'reduce'}),results=[],errors=[];p.on('pageerror',e=>errors.push(e.stack));for(const [device,width,height]of[['desktop',1440,1000],['mobile',390,844]]){await p.setViewportSize({width,height});await p.goto(process.env.ROOT+'/lol-coach/loading.html');await p.waitForSelector('#analyze:enabled');await p.locator('#example-1').click();await p.locator('#analyze').click();const h=p.locator('#loading-coach'),board=h.locator('.coach-board');await board.scrollIntoViewIfNeeded();await board.evaluate(e=>e.scrollIntoView({block:'start',behavior:'instant'}));await p.evaluate(()=>new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r))));const row={device,viewport:{width,height},board:await board.innerText(),height:await board.evaluate(e=>e.getBoundingClientRect().height),required_extra_condition_inputs:0};await p.screenshot({path:process.env.OUT+'/'+device+'-screen.png'});await board.screenshot({path:process.env.OUT+'/'+device+'-board.png'});if(process.env.MODE!=='before'){assert.equal(await h.locator('[data-loading-decision]').count(),4);assert.equal(await h.locator('details[id$="-methods"]').evaluate(e=>e.open),false);assert(await h.locator('.coach-wave-four').isHidden());assert(await h.locator('.coach-quick').isHidden());assert((await h.locator('.coach-summary-exceptions li').count())<=3);const method=h.locator('details[id$="-methods"] > summary');await method.focus();await p.keyboard.press('Enter');assert(await h.locator('.coach-wave-four').isVisible());await h.locator('details[id$="-execution-steps"]').evaluate(e=>e.open=true);await h.locator('[data-coach-focus="card-step-2"]').click();assert.equal(await h.locator('.coach-line').first().getAttribute('data-step'),'2');row.ours=await h.locator('[data-counterplan=ours]').innerText();row.theirs=await h.locator('[data-counterplan=theirs]').innerText();const bridge=h.locator('details[id$="-evidence-bridge"]');await bridge.locator('summary').click();row.bridge=await bridge.innerText();assert.match(row.bridge,/1승 \/ 1경기/);assert(row.bridge.includes('상대가 노리는 것: 말파이트의 지진의 파편(Q)'));assert(row.bridge.includes('성장 후 변경:'));assert.match(row.bridge,/14.9/);assert.match(row.bridge,/275경기/);await bridge.evaluate(e=>e.scrollIntoView({block:'start',behavior:'instant'}));await p.screenshot({path:process.env.OUT+'/'+device+'-bridge-screen.png'});await bridge.screenshot({path:process.env.OUT+'/'+device+'-bridge.png'});assert(await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));await h.locator('details[id$="-conditions"]').evaluate(e=>e.open=true);await h.locator('[data-coach-focus="condition-wave"]').selectOption('UNKNOWN');assert.match(await h.locator('[data-loading-decision=lane]').innerText(),/좁힌다|수급/);assert(!/급소 압박을 바꾼다/.test(await h.locator('[data-loading-decision=lane]').innerText()));row.unknown=await h.locator('[data-loading-decision=lane]').innerText();}results.push(row);}assert.equal(errors.length,0,errors.join('\n'));fs.writeFileSync(process.env.OUT+'/result.json',JSON.stringify({passed:true,mode:process.env.MODE,results,errors},null,2));await b.close();})().catch(e=>{console.error(e);process.exit(1)});